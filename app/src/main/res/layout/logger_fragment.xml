            <Button
                android:id="@+id/retrievelogbutton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:layout_weight="1"
                android:text="@string/RetrieveInternalLogs"
                android:textSize="13sp"
                android:textStyle="bold"
                />

            <TextView
            android:id="@+id/export_log_heading_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Export_Logs"
            android:textSize="18sp"
            android:textColor="#283747"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/export_logs_path_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#283747"
            android:inputType="textPersonName"
            android:text="/sdcard/RfidLog.txt"
            android:layout_marginTop="10dp"
            android:maxLines="3"
            android:singleLine="false"
            android:scrollHorizontally="false"
            android:breakStrategy="simple"
            android:visibility="visible"
            />

            <Button
                android:id="@+id/export_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:layout_weight="1"
                android:text="@string/export"
                android:textStyle="bold"
                android:textSize="13sp"
                android:visibility="visible"/>
        </LinearLayout>


        <EditText
            android:id="@+id/logcats_edittext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            />
    </LinearLayout>

</ScrollView>